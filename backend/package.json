{
  "name": "product-price-tracker-backend",
  "version": "1.0.0",
  "description": "Backend API and scraper for INE Product Price Tracker",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test test/**/*.test.js",
    "test:unit": "node --test test/unit/*.test.js",
    "test:fault": "node --test test/fault/*.test.js",
    "recon": "node src/cli/recon.js",
    "capture:fixtures": "node src/cli/capture-fixtures.js",
    "scrape": "node src/cli/scrape.js",
    "scrape:headed": "node src/cli/scrape.js --headed",
    "probe": "node src/cli/probe.js",
    "sync:catalog": "node src/cli/sync-catalog.js",
    "verify:db": "node src/cli/verify-invariants.js",
    "baseline:update": "node src/cli/update-baseline.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "playwright": "^1.50.1",
    "zod": "^3.24.1"
  }
}
